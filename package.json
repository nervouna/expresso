{
  "name": "pi-expresso",
  "version": "0.1.0",
  "description": "Compact tool groups for Pi's terminal transcript",
  "type": "module",
  "keywords": ["pi-package"],
  "files": ["src", "README.md"],
  "pi": { "extensions": ["./src/index.ts"] },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "verify": "npm run check && npm test",
    "demo": "tsx scripts/demo.ts",
    "test:tui": "python3 scripts/tui-smoke.py"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@earendil-works/pi-tui": "1.0.2",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": { "node": ">=22.19.0" }
}
